<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="701dp"
        android:orientation="vertical"
        android:padding="16dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Título" />

        <EditText
            android:id="@+id/etTituloActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el título del libro" />

        <!-- Autor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Autor" />

        <EditText
            android:id="@+id/etAutorActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el autor" />

        <!-- Género -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Género" />

        <EditText
            android:id="@+id/etGeneroActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el género" />

        <!-- Número de Copias -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Número de Copias" />

        <EditText
            android:id="@+id/etNumeroCopiasActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el número de copias"
            android:inputType="number" />

        <!-- Ubicación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Ubicación" />

        <EditText
            android:id="@+id/etUbicacionActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese la ubicación" />

        <!-- Button to retrieve GPS Location -->
        <Button
            android:id="@+id/btnObtenerUbicacionActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obtener Ubicación GPS" />

        <!-- Button to take a photo -->
        <Button
            android:id="@+id/btnTomarFotoActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tomar Foto" />

        <!-- Preview Image -->
        <ImageView
            android:id="@+id/imgPortadaActualizar"
            android:layout_width="wrap_content"
            android:layout_height="192dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/default_img" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>